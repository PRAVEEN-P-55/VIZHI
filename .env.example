# Core
APP_NAME=VIZHI Predictive Intelligence Platform
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Local default: sqlite:///.../backend/cyberwatch.db
# Docker/PostGIS example:
DATABASE_URL=postgresql+psycopg://vizhi:vizhi@postgres:5432/vizhi
REDIS_URL=redis://redis:6379/0

# Optional Claude intelligence enrichment
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional email provider
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Provider-agnostic JSON webhooks
SMS_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
